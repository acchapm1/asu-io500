# Hook bookkeeping — keep .claude/auto-push.sh + .claude/settings.json
# tracked so fresh clones get the auto-push hook. Ignore only logs,
# session transcripts, and any local-only overrides.
.claude/*.log
.claude/projects/
.claude/settings.local.json
.claude/cache/

# Per-run artifacts we don't want in git
results/*/raw/
results/*/*.tmp
*.log.tmp

# SLURM stdout/stderr at repo root if you launch from here
io500-*.out
io500-*.err

# Editor
*.swp
*.swo
.DS_Store

# dev stuff
output.log
modules
.claude/*
.pixi/*
pixi.lock
